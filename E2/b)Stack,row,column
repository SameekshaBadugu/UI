import 'package:flutter/material.dart';

void main() => runApp(MaterialApp(
  debugShowCheckedModeBanner: false,
  home: Scaffold(
    appBar: AppBar(
      title: Text('Layout Widgets'),
    ),
    body: SingleChildScrollView(
      child: Column(
        children: [
          Text('Row Layout',
            style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),

          Row(
            mainAxisAlignment: MainAxisAlignment.spaceEvenly,
            children: [
              box(Colors.red),
              box(Colors.green),
              box(Colors.blue),
            ],
          ),

          SizedBox(height: 30),

          Text('Column Layout',
            style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),

          Column(
            children: [
              box(Colors.orange),
              SizedBox(height: 10),
              box(Colors.purple),
              SizedBox(height: 10),
              box(Colors.teal),
            ],
          ),

          SizedBox(height: 10),

          Text('Stack Layout',
            style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),

          SizedBox(
            width: 150,
            height: 150,
            child: Stack(
              alignment: Alignment.center,
              children: [
                box(Colors.red, 140),
                box(Colors.green, 100),
                box(Colors.blue, 60),
              ],
            ),
          ),
        ],
      ),
    ),
  ),
));

Widget box(Color color, [double size = 80]) {
  return Container(
    width: size,
    height: size,
    color: color,
  );
}
